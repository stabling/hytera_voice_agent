# 64-bit Voice Agent + MCP Server
HYTERA_ADK_BASE_URL=http://127.0.0.1:18081
HYTERA_LOCAL_API_TOKEN=change-the-same-token-in-both-env-files

CALLBACK_HOST=127.0.0.1
CALLBACK_PORT=18082
SAVE_DIR=received_callbacks
STATE_DB_PATH=data/state.sqlite3
# 联系人+区域/信道目录默认共享同一份设备档案文件：voice_device_directory.json
# （11.json 结构，两个目录模块各自提取自己的视图）。如需改回专用两文件
# 部署，再取消下面的注释并确保对应文件存在。
# VOICE_CONTACT_MAP_FILE=voice_contact_map.json
# VOICE_ZONE_CHANNEL_MAP_FILE=voice_zone_channel_map.json
VOICE_LOG_LEVEL=INFO

# DashScope
DASHSCOPE_API_KEY=sk-3b25fa65bf99483d84e680d420b5ab76
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_AUDIO_ASR_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
# 流式 ASR WebSocket 双工端点（默认即百炼官方地址，可按需覆盖）
#QWEN_ASR_STREAMING_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# ASR 提供方切换：dashscope（阿里云，默认，用上面的 QWEN_ASR_MODEL）或
# local（局域网 OpenAI 兼容自部署 Qwen3-ASR-1.7B，无 API Key，音频 base64）。
# 切到 local：把下一行改为 QWEN_ASR_PROVIDER=local；切回阿里：改回 dashscope。
QWEN_ASR_PROVIDER=dashscope
# 以下三项仅 local 模式生效（默认即为目标值，可按需覆盖）
# QWEN_LOCAL_ASR_BASE_URL=http://10.115.36.37:8000/v1
# QWEN_LOCAL_ASR_MODEL=Qwen3-ASR-1.7B
# QWEN_LOCAL_ASR_API_KEY=
QWEN_PLANNER_MODEL=qwen-flash

# Planner（语义规划）提供方切换：dashscope（阿里云，默认，用上面的
# QWEN_PLANNER_MODEL）或 local（局域网 OpenAI 兼容自部署 qwen3.5-4b，无 API Key）。
# 切到 local：把下一行改为 QWEN_PLANNER_PROVIDER=local；切回阿里：改回 dashscope。
QWEN_PLANNER_PROVIDER=local
# 以下三项仅 local 模式生效（默认即为目标值，可按需覆盖）
QWEN_LOCAL_PLANNER_BASE_URL=https://u598206-ej47-317702fe.bjb2.seetacloud.com:8443/v1
QWEN_LOCAL_PLANNER_MODEL=minicpm5-agent
QWEN_LOCAL_PLANNER_API_KEY=
# local 模式思考模式开关：Qwen3 系列默认关闭思考（规划只需直接 JSON 输出，
# 开思考会拉长延迟且可能混入 content）；如需开启改为 true。
# QWEN_LOCAL_PLANNER_ENABLE_THINKING=false
PLANNER_PROMPT_MODE=compact
PLANNER_CONTEXT_CACHE_ENABLE=true
QWEN_CALL_SUMMARY_MODEL=qwen-plus
QWEN_CALL_TRANSLATION_MODEL=qwen-plus
QWEN_ASR_LANGUAGE=zh
QWEN_ASR_ENABLE_ITN=true
QWEN_AUDIO_ASR_ENABLE_CONTEXT=true
QWEN_AUDIO_ASR_ENABLE_HOTWORDS=true
QWEN_AUDIO_ASR_ENTITY_HOTWORD_WEIGHT=4
QWEN_AUDIO_ASR_TERM_HOTWORD_WEIGHT=3
QWEN_AUDIO_ASR_CONTEXT_MAX_CHARS=400
QWEN_AUDIO_ASR_EXTRA_HOTWORDS=
DASHSCOPE_TIMEOUT_SECONDS=90
QWEN_PLANNER_TIMEOUT_SECONDS=60
QWEN_CALL_SUMMARY_TIMEOUT_SECONDS=60
QWEN_CALL_TRANSLATION_TIMEOUT_SECONDS=60
DASHSCOPE_WAIT_TIMEOUT_SECONDS=0
PLANNER_RATE_LIMIT_RPM=120
PLANNER_MAX_RETRIES=0
ASR_RATE_LIMIT_RPM=45
ASR_RETRY_UNTIL_SUCCESS=true
ASR_MAX_RETRIES=0
ASR_429_SLEEP_SECONDS=65
ASR_RETRY_BASE_SECONDS=8
ASR_RETRY_MAX_SECONDS=300
ASR_RETRY_JITTER_SECONDS=3
ASR_EMPTY_TEXT_MAX_RETRIES=2

# Audio / queue
ASR_WORKER_COUNT=2
ASR_QUEUE_SIZE=128
CANCEL_QUEUED_TASKS_ON_NEW_TASK=true
# 语音回调 ACK 前移：校验/背压通过后立即回 ACK，spool 持久化与 ASR 入队
# 交由后台串行 worker 执行（省 ~125ms 同步 fsync）；回退旧行为改 false
VOICE_INGRESS_ASYNC_PERSIST=true
AUDIO_SAMPLE_RATE=8000
AUDIO_DEFAULT_CODEC=pcmu
AUDIO_PREPROCESS_ENABLE=true    
ASR_TARGET_SAMPLE_RATE=16000
AUDIO_DEBUG_SAVE=false
MIN_AUDIO_SECONDS=0.1
MAX_DATA_URL_BYTES=10485760

# Durable callback input
CALLBACK_MAX_BODY_BYTES=25165824
CALLBACK_SPOOL_DIR=received_callbacks/callback_spool
CALLBACK_SPOOL_MAX_EVENTS=10000
CALLBACK_SPOOL_MAX_BYTES=2147483648
CALLBACK_MAX_AUDIO_BYTES=16777216
CALLBACK_SPOOL_RETENTION_SECONDS=604800
CALLBACK_ACK_STATUS_CODE=202

# State and context
EVENT_JOURNAL_ENABLE=false
EVENT_JOURNAL_PATH=data/state.sqlite3
EVENT_JOURNAL_FAIL_MODE=open
CALL_STORE_ENABLE=true
CALL_STORE_PATH=data/state.sqlite3
CALL_RESOLVE_DEFAULT_SCOPE=same_actor_terminal
CALL_RESOLVE_MAX_CANDIDATES=10
# 上下文构建默认采用只观测模式，不再默认 active。
CONTEXT_BUILDER_MODE=shadow
CONTEXT_STORE_PATH=data/state.sqlite3
CONTEXT_MAX_ITEMS=30
CONTEXT_MAX_TOKENS=3000
MEMORY_ENABLE=false
MEMORY_STORE_PATH=data/state.sqlite3
WORKING_MEMORY_BACKEND=off

# 能力规划与策略
PLAN_MAX_STEPS=6
PLAN_MAX_REPLANS=2
PLAN_MAX_MODEL_CALLS=3
PLAN_TOTAL_TIMEOUT_SECONDS=120
# audit 仅记录风险判定而不阻断执行；需要恢复严格门控时改为 enforce。
POLICY_MODE=audit
AUTO_EXECUTE_MAX_RISK=R1
POLICY_R2_ALLOWLIST=zone_channel_active_set
OPERATION_STORE_PATH=data/state.sqlite3
PLANNING_STORE_PATH=data/state.sqlite3
APPROVAL_STORE_PATH=data/state.sqlite3
APPROVAL_ADMIN_TOKEN=change-this-approval-admin-token
APPROVAL_ALLOWED_ROLES=approver,admin

# MCP: Agent -> MCP -> Gateway -> source terminal
MCP_SERVER_URL=http://127.0.0.1:18083
MCP_PROTOCOL_VERSION=2025-11-25
MCP_TOOL_TIMEOUT_SECONDS=10
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=18083
DEVICE_EXECUTOR_MODE=gateway_terminal
DEVICE_HTTP_BASE_URL=
DEVICE_HTTP_TIMEOUT=10

# Optional storage migration
STORAGE_BACKEND=sqlite
POSTGRES_DSN=
POSTGRES_POOL_SIZE=8
POSTGRES_FAIL_OPEN=true
OBJECT_STORE_ENABLE=false
OBJECT_STORE_BUCKET=
OBJECT_STORE_PREFIX=audio
OBJECT_STORE_ENDPOINT_URL=
OBJECT_STORE_KMS_KEY_ID=

CONTROL_IDS=666
LOCAL_CONTROL_ID=666
