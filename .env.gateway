# 32-bit ADK Gateway
HYTERA_GATEWAY_CONFIG=config/gateway.ini
HYTERA_AGENT_BASE_URL=http://127.0.0.1:18082
HYTERA_LOCAL_API_TOKEN=change-the-same-token-in-both-env-files
HYTERA_LOG_LEVEL=INFO
HYTERA_LOG_CONSOLE=true

# 中转台身份契约（与 .env.agent 保持一致）：
# 网关部署在中转台，CONTROL_IDS/LOCAL_CONTROL_ID 用于入站短信监听
# （[SMS-TO-REPEATER] 日志）与中转台主动语音 source（需求 §2.2）。
CONTROL_IDS=1048607
LOCAL_CONTROL_ID=1048607

# Reliable voice callback delivery
VOICE_CALLBACK_DELIVERY_MODE=outbox
VOICE_CALLBACK_OUTBOX_PATH=voice_capture/callback_outbox.sqlite3
# 静音确认阈值（秒）：最后一个语音包后等待多久才确认说话结束并下发回调。
# 配合 lifecycle tick 粒度后静音确认总时长 <1s；如需回退旧慢速行为改为 2.0
VOICE_CALLBACK_MERGE_GAP_SECONDS=0.4
# Outbox SQLite fsync 策略：NORMAL 消除每条约 45ms 的 fsync；回退旧行为改 FULL
VOICE_CALLBACK_OUTBOX_SYNCHRONOUS=NORMAL
VOICE_CALLBACK_OUTBOX_MAX_EVENTS=10000
VOICE_CALLBACK_OUTBOX_MAX_BYTES=536870912
VOICE_CALLBACK_OUTBOX_RETENTION_SECONDS=604800
VOICE_CALLBACK_OUTBOX_LEASE_SECONDS=30
VOICE_CALLBACK_SENDER_WORKERS=2
VOICE_CALLBACK_SENDER_POLL_SECONDS=0.05
VOICE_CALLBACK_RETRY_MAX_ATTEMPTS=12
VOICE_CALLBACK_CIRCUIT_FAILURE_THRESHOLD=5
VOICE_CALLBACK_CIRCUIT_RESET_SECONDS=30

# Shared event journal contract
EVENT_JOURNAL_ENABLE=false
EVENT_JOURNAL_PATH=data/state.sqlite3
EVENT_JOURNAL_FAIL_MODE=open
OTEL_PROPAGATION_ENABLE=false
EVENT_TYPE_UNKNOWN_POLICY=allow
